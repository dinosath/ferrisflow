# OIDC is opt-in. Copy this file to .env to enable local FerrisKey sign-in.
DATABASE_URL=postgres://postgres:postgres@localhost:5432
AUTH_REQUIRED=true
OIDC_ENABLED=false
OIDC_ISSUER=http://localhost:3333/realms/ferrisflow
OIDC_CLIENT_ID=ferrisflow
OIDC_CLIENT_SECRET=replace-with-client-secret
OIDC_REDIRECT_URI=http://localhost:8080/auth/oidc/callback

# The API validates access tokens using the provider's RFC 7662 endpoint.
OAUTH_INTROSPECTION_URL=http://localhost:3333/realms/ferrisflow/protocol/openid-connect/token/introspect
OAUTH_CLIENT_ID=ferrisflow
OAUTH_CLIENT_SECRET=replace-with-client-secret
OAUTH_READ_SCOPE=ferrisflow:read
OAUTH_WRITE_SCOPE=ferrisflow:write
OAUTH_ADMIN_SCOPE=ferrisflow:admin

# Set false only for local development without an identity provider.
