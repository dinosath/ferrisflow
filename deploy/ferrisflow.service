[Unit]
Description=Ferrisflow workflow service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ferrisflow
Group=ferrisflow
WorkingDirectory=/var/lib/ferrisflow
Environment=IP=127.0.0.1
Environment=PORT=8080
Environment=DATABASE_URL=sqlite:///var/lib/ferrisflow/ferris-workflow.db?mode=rwc
Environment=DIOXUS_PUBLIC_PATH=/opt/ferrisflow/current/public
Environment=RUST_LOG=info
StateDirectory=ferrisflow
StateDirectoryMode=0750
UMask=0027
ExecStart=/opt/ferrisflow/current/ferris-workflow
Restart=on-failure
RestartSec=5
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ReadWritePaths=/var/lib/ferrisflow

[Install]
WantedBy=multi-user.target
