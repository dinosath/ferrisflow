  "database": {
    "contentTypes": []
  },
  "workflows": [
    {
      "document": {
        "dsl": "1.0.3",
        "namespace": "ferrisflow_core",
        "name": "content-types-list",
        "version": "1.0.0",
        "metadata": {
          "rest_api": {
            "enabled": true,
            "method": "GET",
            "path": "/api/content-type-registry"
          },
          "ferrisflow": {
