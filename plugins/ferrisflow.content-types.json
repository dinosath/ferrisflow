  "menuItems": [
    {
      "label": "Content types",
      "path": "/plugins/ferrisflow.content-types/views/content-manager",
      "icon": "table",
      "view": "content-manager"
    }
  ],
  "views": [
    {
      "id": "content-manager",
      "name": "Content manager",
      "type": "collection-manager",
      "route": "/plugins/ferrisflow.content-types/views/content-manager",
      "dataSource": {
        "type": "database.contentTypes"
      },
      "config": {
        "workflowNames": [
          "content-types-list",
          "content-types-create",
          "content-types-read",
          "content-types-update",
          "content-types-delete",
          "content-records-list",
          "content-records-create",
          "content-records-read",
          "content-records-update",
          "content-records-delete"
        ],
        "listView": {
          "api": {
            "method": "GET",
            "path": "/api/content/{uid}"
          },
          "columns": [
            {
              "name": "*",
              "label": "{label}",
              "mapping": "data.{name}",
              "sortable": true,
              "source": "contentType.fields"
            },
            {
              "name": "id",
              "label": "ID",
              "mapping": "id",
              "sortable": true
            },
            {
              "name": "published",
              "label": "Status",
              "mapping": "published",
              "sortable": true
            }
          ],
          "settings": {
            "enableSearch": true,
            "enableFilters": true,
            "enableBulkActions": false,
            "entriesPerPage": 20,
            "defaultSortAttribute": "id",
            "defaultSortOrder": "desc"
          },
          "byType": {}
        },
        "formView": {
          "api": {
            "create": {
              "method": "POST",
              "path": "/api/content/{uid}"
            },
            "update": {
              "method": "PUT",
              "path": "/api/content/{uid}/{id}"
            }
          },
          "create": {
            "title": "Create entry",
            "submitLabel": "Create",
            "fields": []
          },
          "update": {
            "title": "Edit entry",
            "submitLabel": "Save changes",
            "fields": []
          },
          "byType": {}
        }
      },
      "description": "Create content type definitions and manage content records through the plugin workflows."
    }
  ]
