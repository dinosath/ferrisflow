          },
          "ui": {
            "input_schema": {
              "type": "object",
              "properties": {}
            },
            "view": {
              "type": "json",
              "config": {}
            }
          }
        }
      },
      "do": [
        {
          "registry": {
            "call": "ferrisflow.primitive",
            "with": {
              "primitive": "database",
              "operation": "list",
              "table": "content_types",
              "primaryKey": "uid",
              "jsonFields": {
                "schema": "schema_json"
              },
              "input": "${ . }"
            },
            "output": {
              "as": "${ map(select(.uid != \"core.page\")) }"
            }
          }
        }
      ]
    },
    {
      "document": {
        "dsl": "1.0.3",
        "namespace": "ferrisflow_core",
        "name": "content-types-create",
        "version": "1.0.0",
        "metadata": {
          "rest_api": {
            "enabled": true,
            "method": "POST",
            "path": "/api/content-type-registry"
          },
          "ferrisflow": {
            "plugin": "ferrisflow.content-types",
            "name": "Create content type",
            "description": "Create content type definitions",
            "operation": "create"
          },
          "ui": {
            "input_schema": {
              "type": "object",
              "required": [
                "uid",
                "display_name",
                "schema"
              ],
              "properties": {
                "uid": {
                  "type": "string",
                  "title": "API ID",
                  "placeholder": "article"
                },
                "display_name": {
                  "type": "string",
                  "title": "Display name",
                  "placeholder": "Article"
                },
                "schema": {
                  "type": "object",
                  "title": "Fields schema"
                }
              }
            },
            "view": {
              "type": "form",
              "config": {
                "title": "Content type",
                "description": "Define the collection and its fields."
              }
            }
          }
        }
      },
      "do": [
        {
          "definition": {
            "set": {
              "definition": "${ .definition // .request.body // . }"
            }
          }
        },
        {
          "createTable": {
            "call": "ferrisflow.primitive",
            "with": {
              "primitive": "database",
              "operation": "ensure",
              "table": "${ .definition.uid }",
              "input": "${ . }",
              "returnInput": true,
              "columns": "${ [{name: \"id\", type: \"integer\", primaryKey: true}] + (.definition.schema.fields | map({name: .name, type: (if .type == \"integer\" then \"integer\" else if .type == \"number\" then \"number\" else if .type == \"boolean\" then \"boolean\" else \"string\" end end end), required: (.required // false), unique: (.unique // false)})) }"
            },
            "input": {
              "schema": {
                "format": "json",
                "document": {
                  "type": "object",
                  "required": [
                    "definition"
                  ],
                  "properties": {
                    "definition": {
                      "type": "object",
                      "required": [
                        "uid",
                        "display_name",
                        "schema"
                      ],
                      "properties": {
                        "uid": {
                          "type": "string",
                          "pattern": "^[A-Za-z][A-Za-z0-9_]{0,63}$"
                        },
                        "display_name": {
                          "type": "string",
                          "minLength": 1
                        },
                        "schema": {
                          "type": "object",
                          "required": [
                            "fields"
                          ],
                          "properties": {
                            "fields": {
                              "type": "array",
                              "minItems": 1,
                              "items": {
                                "type": "object",
                                "required": [
                                  "name",
                                  "label",
                                  "type"
                                ],
                                "properties": {
                                  "name": {
                                    "type": "string",
                                    "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
                                  },
                                  "label": {
                                    "type": "string",
                                    "minLength": 1
                                  },
                                  "type": {
                                    "enum": [
                                      "text",
                                      "richtext",
                                      "number",
                                      "boolean",
                                      "date",
                                      "email",
                                      "json",
                                      "enum",
                                      "integer"
                                    ]
                                  }
                                }
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        {
          "registerType": {
            "call": "ferrisflow.primitive",
            "with": {
              "primitive": "database",
              "operation": "upsert",
              "table": "content_types",
              "primaryKey": "uid",
              "jsonFields": {
                "schema": "schema_json"
              },
              "input": "${ {uid: .definition.uid, display_name: .definition.display_name, schema: .definition.schema} }",
              "returnInput": true
            }
          }
        },
        {
          "createCrudWorkflows": {
            "run": {
              "workflow": {
                "namespace": "ferrisflow_core",
                "name": "content-type-crud",
                "version": "1.0.0",
                "input": "${ . }"
              }
            }
          }
        }
      ]
    },
