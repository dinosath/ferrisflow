    {
      "document": {
        "dsl": "1.0.3",
        "namespace": "ferrisflow_core",
        "name": "content-type-provision",
        "version": "1.0.0",
        "metadata": {
          "ferrisflow": {
            "plugin": "ferrisflow.content-types"
          }
