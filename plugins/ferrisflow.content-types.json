    {
      "document": {
        "dsl": "1.0.3",
        "namespace": "ferrisflow_core",
        "name": "content-type-crud",
        "version": "1.0.0",
        "metadata": {
          "ferrisflow": {
            "plugin": "ferrisflow.content-types"
          }
        }
      },
      "do": [
        {
          "definition": {
            "set": {
              "definition": "${ .definition // . }",
              "plugin": "${ .plugin }"
            }
          }
        },
        {
          "inputSchema": {
            "set": {
              "definition": "${ .definition // . }",
              "plugin": "${ .plugin }",
              "inputSchema": "${ {type:\"object\",required:(.definition.schema.fields | map(select(.required == true) | .name)),properties:((.definition.schema.fields | map({(.name): ({title:.label,multiline:(.type == \"richtext\"),type:(if .type == \"integer\" then \"integer\" else if .type == \"number\" then \"number\" else if .type == \"boolean\" then \"boolean\" else if .type == \"json\" then \"object\" else \"string\" end end end end)} + (if .minimum != null then {minimum:.minimum} else {} end) + (if .required == true and (.type == \"text\" or .type == \"richtext\") then {minLength:1} else {} end))}) | add) + {id:{type:\"integer\",title:\"Record ID\"}})} }"
            }
          }
        },
        {
          "createCrudWorkflows": {
            "call": "ferrisflow.primitive",
            "with": {
              "primitive": "workflow.instantiate",
              "plugin": "ferrisflow.content-types",
              "template": "crud",
              "parameters": "${ .definition + {ownerPlugin:(.plugin.id // \"ferrisflow.content-types\"), outputView:{type:\"article\",titleField:\"title\",bodyField:(.definition.schema.fields | map(select(.type == \"richtext\") | .name) | first)}, inputSchema:.inputSchema, updateSchema:(.inputSchema + {required:[\"id\"]})} }"
            }
          }
        }
      ]
    }
