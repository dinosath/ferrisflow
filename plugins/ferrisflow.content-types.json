                                    "type": "string",
                                    "minLength": 1
                                  },
                                  "type": {
                                    "enum": [
                                      "text",
                                      "richtext",
                                      "number",
                                      "boolean",
                                      "date",
                                      "email",
                                      "json",
                                      "enum",
                                      "integer"
                                    ]
                                  }
                                }
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
