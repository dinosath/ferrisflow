              "columns": "${ [{name: \"id\", type: \"integer\", primaryKey: true}] + (.definition.schema.fields | map({name: .name, type: (if .type == \"integer\" then \"integer\" else if .type == \"number\" then \"number\" else if .type == \"boolean\" then \"boolean\" else \"string\" end end end), required: (.required // false), unique: (.unique // false)})) }"
            },
            "input": {
              "schema": {
                "format": "json",
                "document": {
                  "type": "object",
                  "required": [
                    "definition"
                  ],
                  "properties": {
                    "definition": {
                      "type": "object",
                      "required": [
                        "uid",
                        "display_name",
                        "schema"
                      ],
                      "properties": {
                        "uid": {
                          "type": "string",
                          "pattern": "^[A-Za-z][A-Za-z0-9_]{0,63}$"
                        },
                        "display_name": {
                          "type": "string",
                          "minLength": 1
                        },
                        "schema": {
                          "type": "object",
                          "required": [
                            "fields"
                          ],
                          "properties": {
                            "fields": {
                              "type": "array",
                              "minItems": 1,
                              "items": {
                                "type": "object",
                                "required": [
                                  "name",
                                  "label",
                                  "type"
                                ],
                                "properties": {
