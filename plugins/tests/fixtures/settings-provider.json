{
  "schemaVersion": 1,
  "id": "tests.settings",
  "name": "Settings provider",
  "version": "1.0.0",
  "resourceTypes": [
    {
      "name": "test-setting",
      "create": "apply-setting"
    }
  ],
  "workflows": [
    {
      "document": {
        "dsl": "1.0.3",
        "namespace": "tests",
        "name": "apply-setting",
        "version": "1.0.0"
      },
      "do": [
        {
          "table": {
            "call": "ferrisflow.primitive",
            "with": {
              "primitive": "database",
              "operation": "ensure",
              "table": "test_settings",
              "columns": [
                { "name": "id", "type": "integer", "primaryKey": true },
                { "name": "value", "type": "string" }
              ],
              "input": "${ . }",
              "returnInput": true
            }
          }
        },
        {
          "record": {
            "call": "ferrisflow.primitive",
            "with": {
              "primitive": "database",
              "operation": "create",
              "table": "test_settings",
              "input": "${ .definition }"
            }
          }
        }
      ]
    }
  ]
}
