      ],
      "document": {
        "dsl": "1.0.3",
        "name": "refresh-brightnovels",
        "namespace": "local",
        "version": "0.2.0",
        "metadata": {
          "ferrisflow": {
            "plugin": "local.novels",
            "description": "Load saved progress and download new chapters."
          },
          "ui": {
            "input_schema": {
              "type": "object",
              "required": [
                "novel_url"
              ],
              "properties": {
                "novel_url": {
                  "type": "string",
                  "title": "Novel URL",
                  "pattern": "^https://brightnovels\\.com/series/[A-Za-z0-9_-]+/?$"
                },
                "chapter_from": {
                  "type": "integer",
                  "minimum": 1,
                  "title": "First chapter"
                },
                "chapter_to": {
                  "type": "integer",
                  "minimum": 1,
                  "title": "Last chapter"
                }
              }
            },
            "view": {
              "type": "form",
              "config": {
                "title": "Refresh novel"
              }
            }
          },
          "rest_api": {
            "enabled": true,
            "method": "POST",
            "path": "/api/novels/refresh"
          }
        }
      },
      "timeout": {
        "after": {
          "minutes": 10
        }
      }
    },
    {
      "document": {
        "dsl": "1.0.3",
        "namespace": "local",
        "name": "save-brightnovels",
        "version": "0.2.0",
        "metadata": {
          "ferrisflow": {
            "plugin": "local.novels",
            "description": "Atomically save a crawled novel and its chapters."
          }
        }
      },
      "input": {
        "schema": {
          "format": "json",
          "document": {
            "type": "object",
            "required": [
              "title",
              "source",
              "chapters",
              "last_downloaded_chapter"
            ],
            "properties": {
              "title": {
                "type": "string",
                "minLength": 1
              },
              "source": {
                "type": "string",
                "pattern": "^https://brightnovels\\.com/series/[A-Za-z0-9_-]+$"
              },
              "last_downloaded_chapter": {
                "type": "integer",
                "minimum": 0
              },
              "chapters": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "number",
                    "name",
                    "url",
                    "body"
                  ],
                  "properties": {
                    "number": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "name": {
                      "type": "string",
                      "minLength": 1
                    },
                    "url": {
                      "type": "string",
                      "minLength": 1
                    },
                    "body": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                }
              }
            }
          }
        }
      },
      "do": [
        {
          "timestamp": {
            "call": "ferrisflow.primitive",
            "with": {
              "primitive": "clock.now"
            },
            "output": {
              "as": "${ $input + {checkedAt:$output} }"
            }
          }
        },
        {
          "persist": {
            "call": "ferrisflow.primitive",
            "with": {
              "primitive": "database.batch",
              "operations": "${ [{operation:\"upsert\",table:\"local_novels_novel\",conflictKey:\"source\",maxFields:[\"last_downloaded_chapter\"],preserveFields:(if .auto_update_explicit == true then [] else [\"auto_update\"] end),input:{title:.title,author:(.author // \"\"),synopsis:(.synopsis // \"\"),cover:(.cover // \"\"),source:.source,source_site:\"brightnovels.com\",last_downloaded_chapter:.last_downloaded_chapter,auto_update:(.auto_update == true),last_checked_at:.checkedAt}}] + (.chapters | map({operation:\"upsert\",table:\"local_novels_chapter\",conflictKey:\"source_url\",input:{novel_source:$input.source,number:.number,title:.name,source_url:.url,body:.body,downloaded_at:$input.checkedAt}})) }",
              "input": "${ . }",
              "returnInput": true
            }
          }
        }
      ]
    },
    {
      "document": {
        "dsl": "1.0.3",
        "namespace": "local",
        "name": "refresh-auto-novels",
        "version": "0.2.0",
        "metadata": {
          "ferrisflow": {
            "plugin": "local.novels",
            "description": "Refresh novels opted into automatic updates every 30 minutes."
          }
        }
      },
      "schedule": {
        "every": {
          "minutes": 30
        }
      },
      "do": [
        {
          "novels": {
            "call": "ferrisflow.primitive",
            "with": {
              "primitive": "database",
              "table": "local_novels_novel",
              "operation": "list",
              "filter": {
                "auto_update": true
              }
            }
          }
        },
        {
          "refreshEach": {
            "for": {
              "each": "novel",
              "in": "."
            },
            "do": [
              {
                "refresh": {
                  "try": [
                    {
                      "download": {
                        "run": {
                          "workflow": {
                            "namespace": "local",
                            "name": "refresh-brightnovels",
                            "version": "0.2.0",
                            "input": "${ {novel_url:$novel.source} }"
                          }
                        }
                      }
                    }
                  ],
                  "catch": {
                    "as": "failure",
                    "do": [
                      {
                        "failed": {
                          "set": {
                            "source": "${ $novel.source }",
                            "error": "${ $failure }"
                          }
                        }
                      }
                    ]
                  }
                }
              }
            ]
          }
        }
      ]
    }
  ],
  "dependencies": [
    {
      "id": "ferrisflow.content-types",
      "version": "^1.1.0"
    }
  ],
  "resources": [
    {
      "type": "content-type",
      "definition": {
        "display_name": "Novels",
        "schema": {
          "fields": [
            {
              "label": "Title",
              "name": "title",
              "required": true,
              "type": "text"
            },
            {
              "label": "Author",
              "name": "author",
              "required": false,
              "type": "text"
            },
            {
              "label": "Synopsis",
              "name": "synopsis",
              "required": false,
              "type": "richtext"
            },
            {
              "label": "Cover",
              "name": "cover",
              "required": false,
              "type": "text"
            },
            {
              "label": "Source",
              "name": "source",
              "required": true,
              "type": "text",
              "unique": true
            },
            {
              "label": "Source Site",
              "name": "source_site",
              "required": false,
              "type": "text"
            },
            {
              "label": "Last Downloaded Chapter",
              "name": "last_downloaded_chapter",
              "required": false,
              "type": "integer",
              "minimum": 0
            },
            {
              "label": "Auto Update",
              "name": "auto_update",
              "required": false,
              "type": "boolean"
            },
            {
              "label": "Last Checked At",
              "name": "last_checked_at",
              "required": false,
              "type": "date"
            }
          ]
        },
        "uid": "local_novels_novel"
      }
    },
    {
      "type": "content-type",
      "definition": {
        "display_name": "Chapters",
        "schema": {
          "fields": [
            {
              "label": "Novel Source",
              "name": "novel_source",
              "required": true,
              "type": "text"
            },
            {
              "label": "Number",
              "name": "number",
              "required": true,
              "type": "integer",
              "minimum": 1
            },
            {
              "label": "Title",
              "name": "title",
              "required": true,
              "type": "text"
            },
            {
              "label": "Source Url",
              "name": "source_url",
              "required": true,
              "type": "text",
              "unique": true
            },
            {
              "label": "Body",
              "name": "body",
              "required": true,
              "type": "richtext"
            },
            {
              "label": "Downloaded At",
              "name": "downloaded_at",
              "required": false,
              "type": "date"
            }
          ]
        },
        "uid": "local_novels_chapter"
      }
    }
  ]
}
