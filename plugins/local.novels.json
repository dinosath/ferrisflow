{
  "description": "Import Brightnovels novels and chapters, browse stored records, and refresh opted-in novels every 30 minutes.",
  "id": "local.novels",
  "menuItems": [
    {
      "label": "Novels",
      "path": "/plugins/local.novels/pages/local_novels_novel",
      "icon": "table",
      "page": "local_novels_novel"
    },
    {
      "label": "Chapters",
      "path": "/plugins/local.novels/pages/local_novels_chapter",
      "icon": "table",
      "page": "local_novels_chapter"
    }
  ],
  "name": "Novels",
  "pages": [
    {
      "id": "local_novels_novel",
      "title": "Novels",
      "view": "local_novels_novel-table"
    },
    {
      "id": "local_novels_chapter",
      "title": "Chapters",
      "view": "local_novels_chapter-table"
    }
  ],
  "schemaVersion": 1,
  "version": "0.2.0",
  "views": [
    {
      "id": "local_novels_novel-table",
      "name": "Novels",
      "type": "datatable",
      "dataSource": {
        "api": {
          "method": "GET",
          "path": "/api/collections/local_novels_novel"
        }
      },
      "config": {
        "columns": [
          {
            "label": "Title",
            "mapping": "title"
          },
          {
            "label": "Author",
            "mapping": "author"
          },
          {
            "label": "Synopsis",
            "mapping": "synopsis"
          },
          {
            "label": "Cover",
            "mapping": "cover"
          },
          {
            "label": "Source",
            "mapping": "source"
          },
          {
            "label": "Source Site",
            "mapping": "source_site"
          },
          {
            "label": "Last Downloaded Chapter",
            "mapping": "last_downloaded_chapter"
          },
          {
            "label": "Auto Update",
            "mapping": "auto_update"
          },
          {
            "label": "Last Checked At",
            "mapping": "last_checked_at"
          }
        ],
        "workflowNames": [
          "local_novels_novel-list",
          "local_novels_novel-create",
          "local_novels_novel-read",
          "local_novels_novel-update",
          "local_novels_novel-delete",
          "crawl-brightnovels",
          "refresh-brightnovels"
        ],
        "createAction": {
          "workflow": "local_novels_novel-create",
          "input": {
            "title": "",
            "author": "",
            "synopsis": "",
            "cover": "",
            "source": "",
            "source_site": "",
            "last_downloaded_chapter": 0,
            "auto_update": false,
            "last_checked_at": ""
          }
        },
        "actions": [
          {
            "label": "Import novel",
            "workflow": "crawl-brightnovels",
            "input": {
              "novel_url": "",
              "chapter_from": 1,
              "chapter_to": 5,
              "auto_update": false
            }
          }
        ],
        "rowActions": [
          {
            "label": "Refresh",
            "workflow": "refresh-brightnovels",
            "inputMapping": {
              "novel_url": "source"
            }
          },
          {
            "label": "Edit",
            "workflow": "local_novels_novel-update"
          },
          {
            "label": "Delete",
            "workflow": "local_novels_novel-delete",
            "inputMapping": {
              "id": "id"
            }
          }
        ]
      }
    },
    {
      "id": "local_novels_chapter-table",
      "name": "Chapters",
      "type": "datatable",
      "dataSource": {
        "api": {
          "method": "GET",
          "path": "/api/collections/local_novels_chapter"
        }
      },
      "config": {
        "columns": [
          {
            "label": "Novel Source",
            "mapping": "novel_source"
          },
          {
            "label": "Number",
            "mapping": "number"
          },
          {
            "label": "Title",
            "mapping": "title"
          },
          {
            "label": "Source Url",
            "mapping": "source_url"
          },
          {
            "label": "Body",
            "mapping": "body"
          },
          {
            "label": "Downloaded At",
            "mapping": "downloaded_at"
          }
        ],
        "workflowNames": [
          "local_novels_chapter-list",
          "local_novels_chapter-create",
          "local_novels_chapter-read",
          "local_novels_chapter-update",
          "local_novels_chapter-delete"
        ],
        "createAction": {
          "workflow": "local_novels_chapter-create",
          "input": {
            "novel_source": "",
            "number": 0,
            "title": "",
            "source_url": "",
            "body": "",
            "downloaded_at": ""
          }
        },
        "rowActions": [
          {
            "label": "Read",
            "workflow": "local_novels_chapter-read",
            "inputMapping": {
              "id": "id"
            }
          },
          {
            "label": "Edit",
            "workflow": "local_novels_chapter-update"
          },
          {
            "label": "Delete",
            "workflow": "local_novels_chapter-delete",
            "inputMapping": {
              "id": "id"
            }
          }
        ]
      }
    }
  ],
  "workflows": [
    {
      "do": [
        {
          "requestInput": {
            "set": "${ .request.body // . }"
          }
        },
        {
          "normalizeInput": {
            "set": "${ if (.chapter_from != null and .chapter_to != null and .chapter_to < .chapter_from) then error(\"Last chapter must be greater than or equal to first chapter\") else . + {novel_url:(.novel_url | rtrimstr(\"/\"))} end }",
            "input": {
              "schema": {
                "format": "json",
                "document": {
                  "type": "object",
                  "required": [
                    "novel_url"
                  ],
                  "properties": {
                    "novel_url": {
                      "type": "string",
                      "title": "Novel URL",
                      "pattern": "^https://brightnovels\\.com/series/[A-Za-z0-9_-]+/?$"
                    },
                    "chapter_from": {
                      "type": "integer",
                      "minimum": 1,
                      "title": "First chapter"
                    },
                    "chapter_to": {
                      "type": "integer",
                      "minimum": 1,
                      "title": "Last chapter"
                    },
                    "auto_update": {
                      "type": "boolean",
                      "title": "Refresh automatically"
                    }
                  }
                }
              }
            }
          }
        },
        {
          "loadStoredNovel": {
            "call": "ferrisflow.primitive",
            "with": {
              "primitive": "database",
              "operation": "list",
              "table": "local_novels_novel",
              "filter": "${ {source:.novel_url} }",
              "input": "${ . }"
            },
            "output": {
              "as": "${ $input + {stored:($output | first)} }"
            }
          }
        },
        {
          "allowBrightnovels": {
            "call": "http",
            "output": {
              "as": "$input"
            },
            "with": {
              "endpoint": "https://brightnovels.com/",
              "headers": {
                "User-Agent": "ows-runtime example"
              },
              "method": "get",
              "output": "content"
            }
          }
        },
        {
          "fetchSeries": {
            "call": "http",
            "output": {
              "as": "$input + { seriesHtml: $output }"
            },
            "with": {
              "endpoint": "${ .novel_url }",
              "headers": {
                "User-Agent": "ows-runtime example"
              },
              "method": "get",
              "output": "content"
            }
          }
        },
        {
          "parseSeries": {
            "set": "${\n  {\n    seriesPage: (\n      .seriesHtml\n      | split(\"data-page=\\\"\") | .[1] | split(\"\\\"\") | .[0]\n      | split(\"&quot;\") | join(\"\\\"\") | fromjson\n    ),\n    novelUrl: .novel_url,\n    novelSlug: (.novel_url | split(\"/\") | map(select(. != \"\")) | last),\n    chapterFrom: (.chapter_from // 1),\n    chapterTo: (.chapter_to // 5),\n    stored: .stored,\n    autoUpdateExplicit: (.auto_update != null),\n    autoUpdate: (if .auto_update != null then (.auto_update) else (.stored.auto_update // false) end),\n    lastDownloaded: (.stored.last_downloaded_chapter // 0),\n    chapters: [],\n    downloaded: []\n  }\n}"
          }
        },
        {
          "fetchChapters": {
            "call": "http",
            "output": {
              "as": "$input + { chaptersResponse: $output }"
            },
            "with": {
              "endpoint": "${ \"https://brightnovels.com/series/\" + .novelSlug + \"/chapters\" }",
              "headers": {
                "Accept": "application/json",
                "User-Agent": "ows-runtime example"
              },
              "method": "get",
              "output": "content"
            }
          }
        },
        {
          "prepareChapters": {
            "set": "${\n  {\n    series: .seriesPage.props.series,\n    autoUpdate: .autoUpdate,\n    autoUpdateExplicit: .autoUpdateExplicit,\n    lastDownloaded: .lastDownloaded,\n    novelUrl: .novelUrl,\n    novelSlug: .novelSlug,\n    chapterFrom: .chapterFrom,\n    chapterTo: .chapterTo,\n    chapters: (\n      .chaptersResponse.chapters\n      | map(select(.is_premium != true))\n      | reverse\n      | map(. + {\n          chapterNumber: ((.number // .chapter_number // (.name | split(\" \") | last)) | tonumber)\n        })\n      | map(select(.chapterNumber >= $input.chapterFrom and .chapterNumber <= $input.chapterTo))\n    ),\n    downloaded: []\n  }\n}"
          }
        },
        {
          "downloadChapters": {
            "do": [
              {
                "fetchChapter": {
                  "call": "http",
                  "output": {
                    "as": "$input + {\n  lastDownloaded: (if $chapter.chapterNumber > $input.lastDownloaded then $chapter.chapterNumber else $input.lastDownloaded end),\n  downloaded: (\n    $input.downloaded + [{\n      number: $chapter.chapterNumber,\n      slug: $chapter.slug,\n      name: $chapter.name,\n      url: (\"https://brightnovels.com/series/\" + $input.novelSlug + \"/\" + $chapter.slug),\n      body: (\n        $output | split(\"data-page=\\\"\") | .[1] | split(\"\\\"\") | .[0]\n        | split(\"&quot;\") | join(\"\\\"\") | fromjson\n        | .props.chapter.content\n        | split(\"&amp;\") | join(\"&\")\n        | split(\"&lt;\") | join(\"<\")\n        | split(\"&gt;\") | join(\">\")\n        | split(\"&quot;\") | join(\"\\\"\")\n        | split(\"&#039;\") | join(\"'\")\n        | split(\"&apos;\") | join(\"'\")\n        | split(\"&nbsp;\") | join(\" \")\n      )\n    }]\n  )\n}"
                  },
                  "with": {
                    "endpoint": "${ \"https://brightnovels.com/series/\" + $input.novelSlug + \"/\" + $chapter.slug }",
                    "headers": {
                      "User-Agent": "ows-runtime example"
                    },
                    "method": "get",
                    "output": "content"
                  }
                }
              }
            ],
            "for": {
              "at": "chapterIndex",
              "each": "chapter",
              "in": ".chapters"
            }
          }
        },
        {
          "result": {
            "set": "${\n  {\n    title: .series.title,\n    auto_update: .autoUpdate,\n    auto_update_explicit: .autoUpdateExplicit,\n    last_downloaded_chapter: .lastDownloaded,\n    author: .series.user.name,\n    synopsis: .series.description,\n    cover: (\"https://brightnovels.com/storage/\" + .series.cover.path),\n    source: .novelUrl,\n    chapter_from: .chapterFrom,\n    chapter_to: .chapterTo,\n    chapters: .downloaded\n  }\n}"
          }
        },
        {
          "saveRecords": {
            "run": {
              "workflow": {
                "namespace": "local",
                "name": "save-brightnovels",
                "version": "0.2.0",
                "input": "${ . }"
              }
            }
          }
        }
      ],
      "document": {
        "dsl": "1.0.3",
        "name": "crawl-brightnovels",
        "namespace": "local",
        "version": "0.2.0",
        "metadata": {
          "ferrisflow": {
            "plugin": "local.novels",
            "description": "Download and save a novel and its chapters."
          },
          "ui": {
            "input_schema": {
              "type": "object",
              "required": [
                "novel_url"
              ],
              "properties": {
                "novel_url": {
                  "type": "string",
                  "title": "Novel URL",
                  "pattern": "^https://brightnovels\\.com/series/[A-Za-z0-9_-]+/?$"
                },
                "chapter_from": {
                  "type": "integer",
                  "minimum": 1,
                  "title": "First chapter"
                },
                "chapter_to": {
                  "type": "integer",
                  "minimum": 1,
                  "title": "Last chapter"
                },
                "auto_update": {
                  "type": "boolean",
                  "title": "Refresh automatically"
                }
              }
            },
            "view": {
              "type": "form",
              "config": {
                "title": "Import novel"
              }
            }
          },
          "rest_api": {
            "enabled": true,
            "method": "POST",
            "path": "/api/novels/import"
          }
        }
      },
      "timeout": {
        "after": {
          "minutes": 10
        }
      }
    },
    {
      "do": [
        {
          "requestInput": {
            "set": "${ .request.body // . }"
