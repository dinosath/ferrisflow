            "set": "${\n  {\n    seriesPage: (\n      .seriesHtml\n      | split(\"data-page=\\\"\") | .[1] | split(\"\\\"\") | .[0]\n      | split(\"&quot;\") | join(\"\\\"\") | fromjson\n    ),\n    novelUrl: .novel_url,\n    novelSlug: (.novel_url | split(\"/\") | map(select(. != \"\")) | last),\n    chapterFrom: (.chapter_from // ((.stored.last_downloaded_chapter // 0) + 1)),\n    chapterTo: (.chapter_to // 999999),\n    stored: .stored,\n    autoUpdateExplicit: (.auto_update != null),\n    autoUpdate: (if .auto_update != null then (.auto_update) else (.stored.auto_update // false) end),\n    lastDownloaded: (.stored.last_downloaded_chapter // 0),\n    chapters: [],\n    downloaded: []\n  }\n}"
          }
        },
        {
