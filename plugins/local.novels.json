            "set": "${ if (.chapter_from != null and .chapter_to != null and .chapter_to < .chapter_from) then error(\"Last chapter must be greater than or equal to first chapter\") else . + {novel_url:(.novel_url | rtrimstr(\"/\"))} end }",
            "input": {
